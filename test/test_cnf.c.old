#include "solver.h"
#include "sat.h"

char* puzzle_path = "input/puzzle1.data";
char* dimacs_path = "input/problem.cnf";

int main(int argc, char** argv)
{
	if (argc == 2)
	{
		puzzle_path = argv[1];
	}

	puzzle p = load_puzzle(puzzle_path);

	if (p == NULL)
	{
		return 1;
	}

	print_puzzle(p);
	
	int puzzle_size = get_size(p);

	solver s = create_solver(p);

	make_cnf(s);
	// print_dimacs(s);
	write_dimacs(s, dimacs_path);

	sat sat1 = create_sat(puzzle_size);

	// run_glucose("glucose", "input", "out");

	read_result_build_solution(sat1, "out");

	display_result(sat1);
	display_solution(sat1);

	// ------- SECOND RESULT ----------

	var* result = get_result(sat1);

	deny_solution(s, result, puzzle_size * puzzle_size);
	write_dimacs(s, dimacs_path);

	sat sat2 = create_sat(puzzle_size);

	// run_glucose("glucose", "input", "out");

	read_result_build_solution(sat2, "out");

	display_result(sat2);
	display_solution(sat2);

	// FREE PROGRAM

	// free_sat(sat1);
	// free_sat(sat2);
	// free_cnf(...);
	free_puzzle(p);

	return 0;
}
